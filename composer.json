{
    "name": "kolesa-team/visa-qiwi-wallet",
    "description": "Client library for Visa Qiwi Wallet checkout",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Igor Borodikhin",
            "email": "iborodikhin@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Qiwi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Qiwi\\Test\\": "tests/suite/"
        }
    },
    "require": {
        "php": ">=8.4",
        "guzzlehttp/guzzle": "^6.0|^7.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "php-cs-fixer/shim": "^3.95",
        "squizlabs/php_codesniffer": "*",
        "phpunit/phpunit": "^13.2"
    }
}
